{
    "editor.fontFamily": "'Courier Prime', 'Source Code Pro', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 14,
    "editor.wordWrap": "bounded",
    "editor.bracketPairColorization.enabled": false,
    "editor.codeLens": false,
    "editor.colorDecorators": false,
    "editor.folding": false,
    "editor.lineHeight": 1.8,
    "editor.lineNumbers": "off",
    "editor.links": false,
    "editor.minimap.enabled": false, // removes minimap
    "editor.overviewRulerBorder": false, // removes border from overview ruler (located on the right, same position as the scrollbar)
    "editor.occurrencesHighlight": "off", // removes highlights occurrences (still works when you select a word)
    "editor.glyphMargin": false, // removes the space used mainly for debugging indicators
    "editor.wordWrapColumn": 60,
    "breadcrumbs.enabled": false,
    "editor.renderLineHighlightOnlyWhenFocus": false,
    "editor.scrollbar.vertical": "hidden",
    "files.autoSave": "afterDelay",
    "files.autoSaveDelay": 5000,
    "workbench.preferredDarkColorTheme": "Monochrome Dark",
    "workbench.preferredHighContrastColorTheme": "Monochrome Dark",
    "workbench.preferredHighContrastLightColorTheme": "Monochrome Light",
    "workbench.preferredLightColorTheme": "Monochrome Light",
    "window.autoDetectColorScheme": true,
    "editor.cursorStyle": "line-thin",
    "workbench.colorTheme": "Monochrome Light Subtle",
    "gitlens.currentLine.enabled": false,
}